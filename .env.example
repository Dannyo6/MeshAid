# ==============================================================================
# MeshAid Environment Variables Template
# Copy this file to .env and configure for local development
# NEVER COMMIT ACTUAL SECRETS OR CREDENTIALS
# ==============================================================================

# Node / Environment
NODE_ENV=development
PORT=4000

# MeshAid Gateway API Service
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=4000
GATEWAY_API_PREFIX=/api/v1
GATEWAY_API_KEY=your_secure_random_api_key_here

# Central Ingestion Database (PostgreSQL / MongoDB)
DATABASE_URL=postgresql://meshaid_user:meshaid_password@localhost:5432/meshaid_db

# WebSocket Ingestion / Telemetry
WS_PORT=4001

# Emergency Dashboard Configuration
VITE_API_BASE_URL=http://localhost:4000
VITE_WS_BASE_URL=ws://localhost:4001

# BLE Simulation / Testing Parameters
BLE_DEFAULT_SERVICE_UUID=a82f1900-1111-2222-3333-444455556666
BLE_DEFAULT_CHARACTERISTIC_UUID=a82f1901-1111-2222-3333-444455556666
DEFAULT_TTL_SECONDS=172800
MAX_HOPS_DEFAULT=7
