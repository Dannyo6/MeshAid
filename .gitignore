# ==============================================================================
# MeshAid Root .gitignore
# Covers Node.js, TypeScript, Android/Kotlin, Gradle, IDEs, and Secrets
# ==============================================================================

# Node.js & Package Managers
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/
dist/
out/
build/
coverage/
.nyc_output/

# Secrets & Environment Variables (NEVER COMMIT)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.crt
credentials.json
google-services.json
secrets.properties

# Android & Gradle
.gradle/
**/build/
local.properties
*.apk
*.aab
*.ap_
output-metadata.json
*.jks
*.keystore

# Android Studio & IntelliJ IDEA
.idea/
*.iml
*.ipr
*.iws
.navigation/
captures/

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# Local Databases & Spoolers
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# OS Artifacts
Thumbs.db
Desktop.ini
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db

# Temporary & Log files
*.log
*.tmp
*.bak
scratch/
