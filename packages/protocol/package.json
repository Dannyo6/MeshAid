{
  "name": "@meshaid/protocol",
  "version": "0.1.0",
  "description": "Core protocol models, serialization, and DTN store-carry-forward relay engine for MeshAid",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./codec.ts": {
      "types": "./src/codec.ts",
      "import": "./src/codec.ts",
      "default": "./src/codec.ts"
    },
    "./codec": {
      "types": "./dist/codec.d.ts",
      "import": "./dist/codec.js",
      "default": "./dist/codec.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "node --experimental-strip-types --test tests/relay.test.ts tests/codec.test.ts",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "meshaid",
    "dtn",
    "delay-tolerant-networking",
    "opportunistic-mesh",
    "store-carry-forward",
    "protocol"
  ],
  "author": "Dhanush V",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.1",
    "typescript": "^5.7.2"
  }
}
